<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core/**/*.cs;Tests/**/*.cs" />
    <ProjectReference Include="Core/RandevuPlanlayici.Core.csproj" />
    <None Update="Fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
